{
  "name": "pitchtrain",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-reading-samples.mjs",
    "prebuild": "node scripts/build-reading-samples.mjs",
    "pretypecheck": "node scripts/build-reading-samples.mjs",
    "pretest": "node scripts/build-reading-samples.mjs",
    "build": "react-router build && node scripts/generate-service-worker.mjs",
    "dev": "react-router dev",
    "preview": "vite preview --outDir build/client",
    "start": "vite preview --outDir build/client",
    "gen:pwa": "pwa-assets-generator",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "eval:spikes": "vite-node --config vitest.config.ts scripts/eval-spike-filter.ts",
    "agg:spikes": "vite-node --config vitest.config.ts scripts/agg-spike-filter.ts",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@react-router/node": "7.18.0",
    "@react-router/serve": "7.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.1.36",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "pitchfinder": "^2.3.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.4",
    "react-resizable-panels": "^4.11.2",
    "react-router": "7.18.0",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-node": "^3.2.4",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.0"
  }
}
